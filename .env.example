# PostgreSQL connection used by the indexer and migration command.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swega

# Optional for public GitHub repositories; recommended for higher API limits.
GITHUB_TOKEN=

# Required by `embed-memory` and `search` for the current concrete provider.
OPENAI_API_KEY=

# Optional. Defaults to text-embedding-3-small.
SWEGA_EMBEDDING_MODEL=

# Optional. Defaults to .swega/repositories inside this project.
SWEGA_REPOSITORY_DIR=
