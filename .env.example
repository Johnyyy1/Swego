# PostgreSQL connection used by the indexer and migration command.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swega

# Optional for public GitHub repositories; recommended for higher API limits.
GITHUB_TOKEN=

# Local embeddings are the default and do not require API credentials.
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Optional alternative. Required only when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional local cross-encoder reranking. SWEGA never starts the server or
# downloads this model during search; see docs/reranking.md for setup.
RERANKER_PROVIDER=
LLAMA_CPP_RERANKER_URL=http://127.0.0.1:8091
LLAMA_CPP_RERANKER_MODEL=Qwen3-Reranker-0.6B.Q4_K_M

# Optional. Defaults to .swega/repositories inside this project.
SWEGA_REPOSITORY_DIR=
